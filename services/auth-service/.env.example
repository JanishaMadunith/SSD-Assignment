PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=replace_with_database_password
DB_NAME=healthcare

# Same value in every service. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed by CORS (the frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google sign-in (OpenID Connect). Create an OAuth client of type "Web
# application" in Google Cloud. The secret stays here, server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URLs Google may return to (comma-separated). Each one must also be
# listed under "Authorised redirect URIs" on the Google OAuth client.
GOOGLE_REDIRECT_URIS=http://localhost:5173/auth/callback,http://localhost:3000/auth/callback
# GOOGLE_ISSUER_URL is only for the automated tests; leave it unset.

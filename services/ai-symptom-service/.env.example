PORT=3007
# V04: REQUIRED — generate with: openssl rand -base64 48
# Never commit a real value here. Copy to .env and set a unique high-entropy secret.
JWT_SECRET=

DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=replace_with_database_password
DB_NAME=healthcare

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

WHISPER_BASE_URL=http://whisper:9001

TTS_BASE_URL=http://tts:5002
TTS_MODEL=kokoro
TTS_VOICE=af_sarah
TTS_AUDIO_FORMAT=mp3

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=3600

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Comma-separated browser origins allowed by CORS (the frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
